# Staging only. Copy to .env.staging.local; never use production keys here.
TEMPO_ENV=staging
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# These values belong in Vercel's Preview environment too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Use sandbox payment keys and a staging-only webhook URL.
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
BREVO_API_KEY=
MAIL_FROM=Tempo Staging <info@playtempo11.com>
CRON_SECRET=
